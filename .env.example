# Copie para .env e preencha. NEVER comite o .env.

# ---------------------------------------------------------------- front
# artifacts/menupro/.env
# Chave publica do Clerk (dashboard.clerk.com -> API Keys -> Publishable key)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# URL da API quando ela roda em outro host que o front (GitHub Pages).
# Em dev local deixa vazio: o front usa o mesmo origin (/api).
VITE_API_URL=

# ---------------------------------------------------------------- api
# artifacts/api-server/.env
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# String de conexao do Postgres
DATABASE_URL=postgres://usuario:senha@host:5432/banco

LOG_LEVEL=info
